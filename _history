 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n    `;\r\n    export const emptyTile = image.create(16, 16);\r\n    emptyTile.fill(game.Color.Transparent);\r\n\r\n    export function load(id: number, target: Sprite) {\r\n        switch (id) {\r\n            case (0): {\r\n                tiles.setCurrentTilemap(tilemap`level1`);\r\n            }\r\n        }\r\n\r\n        let points = tiles.getTilesByType(img`\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n            2 2 2 2 2 2 2 2 2 2 2 2 2 2 2 2\r\n        `);\r\n\r\n        for (let i of points) {\r\n            tiles.placeOnTile(target, i);\r\n            tiles.setTileAt(i, emptyTile);\r\n        }\r\n    }\r\n}\r\n\r\nmodule Horizon.Init.Resources {\r\n    export const PlayerImg = createImage(\r\n        8,\r\n        8,\r\n        game.Color.Yellow\r\n    );\r\n}\r\n\r\nnamespace Horizon.Anchor {\r\n    export const jumpY = 210;\r\n    export const jumpX = 210;\r\n\r\n    export let currentAnchor = Anchor.AnchorDirection.DOWN;\r\n\r\n    export enum AnchorDirection {\r\n        DOWN,\r\n        UP,\r\n        LEFT,\r\n        RIGHT\r\n    }\r\n\r\n    export function anchorToColDirection(anchor: AnchorDirection): CollisionDirection {\r\n        switch (anchor) {\r\n            case (AnchorDirection.DOWN): {\r\n                return CollisionDirection.Bottom;\r\n            }\r\n            case (AnchorDirection.UP): {\r\n                return CollisionDirection.Top;\r\n            }\r\n            case (AnchorDirection.LEFT): {\r\n                return CollisionDirection.Left;\r\n            }\r\n            case (AnchorDirection.RIGHT): {\r\n                return CollisionDirection.Right;\r\n            }\r\n        }\r\n\r\n        return null;\r\n    }\r\n\r\n    export function colToAnchor(col: CollisionDirection): AnchorDirection {\r\n        switch (col) {\r\n            case (CollisionDirection.Bottom): {\r\n                return AnchorDirection.DOWN;\r\n            }\r\n            case (CollisionDirection.Top): {\r\n                return AnchorDirection.UP;\r\n            }\r\n            case (CollisionDirection.Left): {\r\n                return AnchorDirection.LEFT;\r\n            }\r\n            case (CollisionDirection.Right): {\r\n                return AnchorDirection.RIGHT;\r\n            }\r\n        }\r\n        return null;\r\n    }\r\n\r\n    export function jumpAsGravity(target: Sprite) {\r\n        switch (currentAnchor) {\r\n            case (AnchorDirection.DOWN): {\r\n                target.vy = -jumpY;\r\n                break;\r\n            }\r\n            case (AnchorDirection.UP): {\r\n                target.vy = jumpY;\r\n                break;\r\n            }\r\n            case (AnchorDirection.LEFT): {\r\n                target.vx = jumpX;\r\n                break;\r\n            }\r\n            case (AnchorDirection.RIGHT): {\r\n                target.vx = -jumpX;\r\n                break;\r\n            }\r\n        }\r\n    }\r\n\r\n    export function applyGravity(target: Sprite) {\r\n        switch (currentAnchor) {\r\n            case (AnchorDirection.DOWN): {\r\n                target.ay = 650;\r\n                break;\r\n            }\r\n            case (AnchorDirection.UP): {\r\n                target.ay = -650;\r\n                break;\r\n            }\r\n            case (AnchorDirection.LEFT): {\r\n                target.ax = -650;\r\n                break;\r\n            }\r\n            case (AnchorDirection.RIGHT): {\r\n                target.ax = 650;\r\n                break;\r\n            }\r\n        }\r\n\r\n        if ((currentAnchor == AnchorDirection.UP) || (currentAnchor == AnchorDirection.DOWN)) {\r\n            controller.moveSprite(\r\n                target,\r\n                150,\r\n                0\r\n            );\r\n        } else {\r\n            controller.moveSprite(\r\n                target,\r\n                0,\r\n                150\r\n            );\r\n        }\r\n    }\r\n}\r\n\r\nnamespace Horizon.Init {\r\n    export function bootstrap() {\r\n        /// LOADS THREADS\r\n        GameBeginPayload.deploy();\r\n    }\r\n\r\n    /// PAYLOADS\r\n    export const GameBeginPayload = new Payload();\r\n\r\n    /// PACKETS\r\n    GameBeginPayload.attach(function primaryGameThread() {\r\n        const Player = entries.sprite(\r\n            \"Player\",\r\n            Resources.PlayerImg,\r\n            SpriteKind.Player\r\n        );\r\n\r\n        Maps.load(\r\n            0,\r\n            Player\r\n        );\r\n\r\n        new Runnable(function playerControlsSetup() {\r\n\r\n            controller.A.onEvent(ControllerButtonEvent.Pressed, function jumpWithA() {\r\n                if (Player.isHittingTile(Anchor.anchorToColDirection(Anchor.currentAnchor))) {\r\n                    Anchor.jumpAsGravity(Player);\r\n                }\r\n            });\r\n        }).run();\r\n\r\n        forever(function () {\r\n            let a = Anchor.currentAnchor;\r\n\r\n            if (Player.isHittingTile(CollisionDirection.Bottom)) {\r\n                a = Anchor.AnchorDirection.DOWN;\r\n            }\r\n            if (Player.isHittingTile(CollisionDirection.Top)) {\r\n                a = Anchor.AnchorDirection.UP;\r\n            }\r\n            if (Player.isHittingTile(CollisionDirection.Left)) {\r\n                a = Anchor.AnchorDirection.LEFT;\r\n            }\r\n            if (Player.isHittingTile(CollisionDirection.Right)) {\r\n                a = Anchor.AnchorDirection.RIGHT;\r\n            }\r\n\r\n            info.setScore(a)\r\n        });\r\n\r\n        scene.onHitWall(SpriteKind.Player, )\r\n\r\n        forever(function () {\r\n            Anchor.applyGravity(Player);\r\n        })\r\n    });\r\n\r\n    /// HELPERS\r\n    export function resetPlayerControls(target: Sprite) {\r\n        Anchor.applyGravity(target);\r\n    }\r\n}\r\n\r\nHorizon.Init.bootstrap();","README.md":" ","assets.json":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"tile1\": {\n        \"data\": \"hwQQABAAAAAREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREREQ==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"myTile\"\n    },\n    \"tile2\": {\n        \"data\": \"hwQQABAAAAAiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIg==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"myTile0\"\